<Window
    x:Class="GalaxyWearable.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Galaxy Wearable">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Windows-style navigation rail -->
        <Grid Grid.Column="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="22,28,18,24" Spacing="8">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE7F4;" FontSize="22"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Galaxy Wearable" FontSize="19" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="for Windows" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Padding="8,8,8,0" Spacing="4">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE773;" FontSize="16"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Devices" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border CornerRadius="6" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Device activity"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
                <Border CornerRadius="6" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE713;" FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Settings"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Padding="18,16,18,22" Spacing="5">
                <TextBlock Text="GALAXY WEARABLE" FontSize="10" FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Windows companion" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Main Windows app surface -->
        <Grid Grid.Column="1" Padding="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="Devices" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Connect to your Samsung Galaxy watch or band."
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Content="Scan for devices"
                        Click="ScanButton_Click" VerticalAlignment="Center"
                        MinHeight="38" />
            </Grid>

            <Border Grid.Row="1" Padding="18,15" CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE702;" FontSize="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Nearby Bluetooth devices" FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DiscoveryHint"
                                   Text="Start scanning to discover nearby Samsung wearables."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Available devices" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect"
                            Click="ConnectButton_Click" IsEnabled="True" />
                </Grid>

                <ListView x:Name="DevicesList" Grid.Row="1" SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,8,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" Margin="0,0,0,8" CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="22"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Address}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding ConnectableText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SignalText}" FontSize="12"
                                                   HorizontalAlignment="Right" />
                                        <FontIcon Glyph="&#xE701;" FontSize="14"
                                                  HorizontalAlignment="Right"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Row="3" Margin="0,18,0,0" Padding="18"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Connection details" FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ConnectionHint"
                                       Text="Select a discovered Samsung wearable to inspect its available services."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="HeartRateButton" Grid.Column="1"
                                Content="Enable heart rate"
                                Click="HeartRateButton_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Heart-rate notifications are available only when the device exposes the standard Bluetooth LE heart-rate service. This is not full Samsung phone pairing."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="GattDetails" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
