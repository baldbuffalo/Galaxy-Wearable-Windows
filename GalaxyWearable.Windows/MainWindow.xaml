<Window
    x:Class="GalaxyWearable.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Galaxy Wearable for Windows">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="24,20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="Galaxy Wearable" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows companion · Galaxy Fit3 research build" Opacity="0.72" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Nearby Bluetooth devices" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DiscoveryHint" Text="Start scanning to discover nearby Bluetooth LE advertisements." Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="Start scanning" Click="ScanButton_Click" />
                    <Button x:Name="ConnectButton" Content="Connect selected" Click="ConnectButton_Click" />
                </StackPanel>
            </Grid>
            <ListView x:Name="DevicesList" Grid.Row="1" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Address}" Opacity="0.7" />
                                    <TextBlock Text="{Binding ConnectableText}" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SignalText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Border Grid.Row="2" Padding="16,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ConnectionHint" Text="Select a discovered device, then connect to inspect its GATT services." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="HeartRateButton" Content="Enable heart-rate notifications" Click="HeartRateButton_Click" />
                    <TextBlock Text="Standard BLE feature only; not full Samsung phone pairing." VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="GattDetails" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
