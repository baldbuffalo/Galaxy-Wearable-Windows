<Window
    x:Class="GalaxyWearable.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Galaxy Wearable">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="22,28,18,24" Spacing="8">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE7F4;" FontSize="22"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Galaxy Wearable" FontSize="19" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="for Windows" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Padding="8,8,8,0" Spacing="4">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE773;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="My devices" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Padding="18,16,18,22" Spacing="5">
                <TextBlock Text="GALAXY WEARABLE" FontSize="10" FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Windows companion" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Padding="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="My devices" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Your Samsung Galaxy watches and bands."
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Content="Find devices"
                        Click="ScanButton_Click" VerticalAlignment="Center"
                        MinHeight="38" />
            </Grid>

            <Border Grid.Row="1" Padding="18,15" CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,20">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE702;" FontSize="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Nearby devices" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiscoveryHint"
                                   Text="Choose Find devices to look for nearby Samsung wearables."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Available wearables" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <ListView x:Name="DevicesList" Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="DevicesList_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,8,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Stylised wearable illustration, kept local and resolution-independent -->
                                    <Border Width="136" Height="156" CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <Border Width="42" Height="132" CornerRadius="12"
                                                    Background="#FF34363B"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            <Border Width="66" Height="78" CornerRadius="19"
                                                    Background="#FF17191D"
                                                    BorderBrush="#FF777B83" BorderThickness="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Border Margin="7" CornerRadius="13"
                                                            Background="#FF242832" />
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Spacing="5">
                                                        <TextBlock Text="10:08" FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White" />
                                                        <Border Width="28" Height="3" CornerRadius="2"
                                                                Background="#FF6E9BFF" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="7"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Samsung Galaxy wearable"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding ConnectableText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SignalText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="18"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
