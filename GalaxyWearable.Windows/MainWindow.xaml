<Window
    x:Class="GalaxyWearable.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Galaxy Wearable">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="22,28,18,24" Spacing="8">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE7F4;" FontSize="22"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Galaxy Wearable" FontSize="19" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="for Windows" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Padding="8,8,8,0" Spacing="4">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE773;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="My devices" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Padding="12,12,12,18">
                <Button HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        HorizontalContentAlignment="Stretch"
                        Padding="12,11"
                        MinWidth="0"
                        CornerRadius="9"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OpenUpdates_Click"
                        AutomationProperties.Name="Galaxy Wearable Windows companion, open software updates">
                    <StackPanel Spacing="5">
                        <TextBlock Text="GALAXY WEARABLE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Windows companion"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <FontIcon Grid.Column="1"
                                      Glyph="&#xE76C;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="MainPage" Grid.Column="1" Padding="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="My devices" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Your Samsung Galaxy watches and bands."
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Content="Find devices"
                        Click="ScanButton_Click" VerticalAlignment="Center"
                        MinHeight="38" />
            </Grid>

            <Border Grid.Row="1" Padding="18,15" CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,20">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE702;" FontSize="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Nearby devices" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiscoveryHint"
                                   Text="Choose Find devices to look for nearby Samsung wearables."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Available wearables" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <ListView x:Name="DevicesList" Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="DevicesList_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,8,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" Margin="0,0,0,12" CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="164" Height="176" CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="42"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{Binding ProductImage}"
                                                   AutomationProperties.Name="{Binding ProductImageDescription}"
                                                   Stretch="Uniform"
                                                   Margin="8" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="7"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Samsung Galaxy wearable"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding ConnectableText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SignalText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="18"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid x:Name="UpdatesPage" Grid.Column="1" Padding="32,28,32,24"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="14">
                <Button Content="&#xE72B;  Back to devices" Click="BackFromUpdates_Click"
                        HorizontalAlignment="Left" />
                <TextBlock Text="Software updates" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Check whether a newer version of Galaxy Wearable for Windows is available."
                           FontSize="14" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,28,0,0" Padding="22" CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatusText"
                               Text="Select Check for updates to compare this app with the latest release."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates"
                                Click="CheckUpdatesButton_Click" HorizontalAlignment="Left"
                                MinHeight="40" />
                        <Button x:Name="UpdateButton" Content="Update now"
                                Click="UpdateButton_Click" HorizontalAlignment="Left"
                                MinHeight="40" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
